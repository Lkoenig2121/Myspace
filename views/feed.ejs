<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Friend Updates - MySpace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body class="bg-gray-100 min-h-screen">
    <nav class="bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg">
      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between py-4">
          <div class="text-2xl font-bold">
            <a href="/" class="hover:text-blue-200 transition">MySpace</a>
          </div>

          <div class="hidden md:flex items-center space-x-6">
            <a href="/" class="hover:text-blue-200 transition font-semibold">
              <i class="fas fa-home mr-1"></i> Home
            </a>
            <a href="/feed" class="md:bg-white/20 md:px-3 md:py-1 md:rounded hover:text-blue-200 transition font-semibold">
              <i class="fas fa-newspaper mr-1"></i> Friend Updates
            </a>
            <a href="/profile/<%= currentUser.username %>" class="hover:text-blue-200 transition font-semibold">
              <i class="fas fa-user mr-1"></i> My Profile
            </a>
            <a href="/profile/edit" class="hover:text-blue-200 transition font-semibold">
              <i class="fas fa-edit mr-1"></i> Edit Profile
            </a>
            <a href="/auth/logout" class="hover:text-blue-200 transition font-semibold">
              <i class="fas fa-sign-out-alt mr-1"></i> Logout
            </a>
          </div>

          <div class="hidden md:block text-sm">
            Welcome, <strong><%= currentUser.displayName %></strong>!
          </div>

          <button
            id="mobile-menu-button"
            class="md:hidden text-white focus:outline-none"
            onclick="toggleMobileMenu()"
            aria-label="Toggle menu"
          >
            <i class="fas fa-bars text-2xl"></i>
          </button>
        </div>

        <div id="mobile-menu" class="hidden md:hidden pb-4 pt-2">
          <div class="flex flex-col space-y-3">
            <div class="text-sm pb-2 border-b border-blue-400">
              <i class="fas fa-user-circle mr-2"></i>
              Welcome, <strong><%= currentUser.displayName %></strong>!
            </div>
            <a href="/" class="hover:text-blue-200 transition font-semibold py-2 px-2 rounded hover:bg-blue-700">
              <i class="fas fa-home mr-2"></i> Home
            </a>
            <a href="/feed" class="bg-white/20 px-2 py-2 rounded hover:bg-blue-700 font-semibold">
              <i class="fas fa-newspaper mr-2"></i> Friend Updates
            </a>
            <a href="/profile/<%= currentUser.username %>" class="hover:text-blue-200 transition font-semibold py-2 px-2 rounded hover:bg-blue-700">
              <i class="fas fa-user mr-2"></i> My Profile
            </a>
            <a href="/profile/edit" class="hover:text-blue-200 transition font-semibold py-2 px-2 rounded hover:bg-blue-700">
              <i class="fas fa-edit mr-2"></i> Edit Profile
            </a>
            <a href="/auth/logout" class="hover:text-blue-200 transition font-semibold py-2 px-2 rounded hover:bg-blue-700">
              <i class="fas fa-sign-out-alt mr-2"></i> Logout
            </a>
          </div>
        </div>
      </div>
    </nav>

    <script>
      function toggleMobileMenu() {
        const menu = document.getElementById('mobile-menu');
        const button = document.getElementById('mobile-menu-button');
        const icon = button.querySelector('i');
        menu.classList.toggle('hidden');
        if (menu.classList.contains('hidden')) {
          icon.classList.remove('fa-times');
          icon.classList.add('fa-bars');
        } else {
          icon.classList.remove('fa-bars');
          icon.classList.add('fa-times');
        }
      }
    </script>

    <div class="container mx-auto px-4 py-8 max-w-3xl">
      <h1 class="text-3xl font-bold text-gray-800 mb-2">Friend Updates</h1>
      <p class="text-gray-600 mb-6">See what your friends are up to — profile updates, posts, and more.</p>

      <!-- Share / Post box -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-6 border border-gray-200">
        <form action="/feed/post" method="POST">
          <label for="content" class="block text-sm font-semibold text-gray-700 mb-2">What's on your mind?</label>
          <textarea
            id="content"
            name="content"
            rows="3"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none"
            placeholder="Share a status or blog post..."
            maxlength="2000"
          ></textarea>
          <button
            type="submit"
            class="mt-3 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-5 rounded-lg transition"
          >
            <i class="fas fa-paper-plane mr-1"></i> Post
          </button>
        </form>
      </div>

      <!-- Feed stream -->
      <div class="space-y-4">
        <% if (feed.length === 0) { %>
        <div class="bg-white rounded-xl shadow-md p-8 text-center text-gray-500 border border-gray-200">
          <i class="fas fa-newspaper text-4xl mb-3 text-gray-300"></i>
          <p class="font-medium">No friend updates yet</p>
          <p class="text-sm mt-1">Add some friends and ask them to update their profiles or post — their activity will show up here.</p>
          <a href="/" class="inline-block mt-4 text-blue-600 hover:underline font-semibold">Discover people</a>
        </div>
        <% } else { %>
        <% feed.forEach(function(item) { %>
        <article class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-200">
          <div class="p-4 flex items-center gap-3 border-b border-gray-100">
            <a href="/profile/<%= item.username %>" class="font-bold text-gray-800 hover:text-blue-600">
              <%= item.display_name %>
            </a>
            <span class="text-gray-400">@<%= item.username %></span>
            <span class="text-gray-400 text-sm ml-auto">
              <%= new Date(item.created_at).toLocaleDateString() %> at <%= new Date(item.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
            </span>
          </div>
          <div class="p-4">
            <% if (item.type === 'profile_update') { %>
            <p class="text-gray-700">
              <i class="fas fa-user-edit text-blue-500 mr-2"></i>
              <%= item.content %>
              <% if (item.extra) { %>
              <% try { const extra = JSON.parse(item.extra); if (extra.mood) { %>
              — mood: <span class="font-semibold"><%= extra.mood %></span>
              <% } } catch(e) {} %>
              <% } %>
            </p>
            <% } else if (item.type === 'blog_post') { %>
            <p class="text-gray-800 whitespace-pre-wrap"><%= item.content %></p>
            <% } else if (item.type === 'photo_upload') { %>
            <p class="text-gray-700">
              <i class="fas fa-image text-purple-500 mr-2"></i>
              <%= item.content || 'uploaded a photo' %>
            </p>
            <% } else if (item.type === 'video_upload') { %>
            <p class="text-gray-700">
              <i class="fas fa-video text-pink-500 mr-2"></i>
              <%= item.content || 'uploaded a video' %>
            </p>
            <% } else { %>
            <p class="text-gray-700"><%= item.content || 'Something new' %></p>
            <% } %>
          </div>
          <div class="px-4 pb-3">
            <a href="/profile/<%= item.username %>" class="text-sm text-blue-600 hover:underline">View profile</a>
          </div>
        </article>
        <% }); %>
        <% } %>
      </div>
    </div>
  </body>
</html>
